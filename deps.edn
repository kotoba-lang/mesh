;; `resources` is on :paths because the shipped decision core is loaded from
;; it at runtime, not merely built into something: `kotoba.mesh.kotoba-oracle`
;; reads `mesh/oracle/route.kir.edn` off the classpath every time the node
;; classifies a request.
{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        io.github.kotoba-lang/kotoba
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b088946215085d56cbd64e1a6e19729f0308dcfe"}
        io.github.kotoba-lang/kotoba-selfhost-contracts
        {:git/url "https://github.com/kotoba-lang/kotoba-selfhost-contracts.git"
         :git/sha "ea3bc8233720ad81ea0b6e2387e45dabc9231a7f"}
        ;; The KIR interpreter is a RUNTIME dependency: it is what makes
        ;; `src/kotoba/mesh/route.kotoba` the thing that RUNS rather than
        ;; something a test compares against.
        ;;
        ;; The compiler added for GENERATING that artifact is test-only (see
        ;; :test). What is NOT true here, and is true in the sibling repos this
        ;; seam was copied from, is that no compiler reaches a consumer:
        ;; measured 2026-08-12, `io.github.kotoba-lang/amu` 3a475011 is
        ;; already on this repository's runtime classpath, transitively via
        ;; `kotoba`, and it was there before any of this landed. It has to be --
        ;; `kotoba.mesh.node/compile-route` compiles operator-supplied `.kotoba`
        ;; routes at startup, which is what this repository IS. So the rule kept
        ;; here is the narrower true one: the compiler that produced the shipped
        ;; artifact is test-only, and nothing at runtime compiles a decision
        ;; core.
        ;;
        ;; Adding this pin MOVED the version the rest of the tree resolves:
        ;; kotoba-kir went d968c01c -> d58972da (`:use-top`). Safe, and measured
        ;; rather than assumed -- `kotoba` itself references `kotoba.kir` in
        ;; zero files, so the legacy compile/emit/Chicory path does not read KIR
        ;; at all, and that whole path is exercised green by
        ;; `drama-profile-test` and `node-test`.
        ;;
        ;; Pinned to the kir the pinned compiler emits for
        ;; (`io.github.kotoba-lang/amu` 806f5cef declares kotoba-kir
        ;; d58972da). They have to match: KIR is a versioned document, and an
        ;; interpreter reading a shape its emitter did not write is exactly the
        ;; failure the artifact was supposed to remove. Measured 2026-08-12 on
        ;; a sibling repository: mixing a newer interpreter under an older
        ;; compiler produced 1 failure / 32 errors, and advancing the compiler
        ;; instead is a source-level language migration (`string=?` returns
        ;; :i64 at this pin and :bool on compiler main), not a pin bump.
        io.github.kotoba-lang/kotoba-kir
        {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
         :git/sha "d58972da61758584a5bec0e863bcb3ea6fdd6c64"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "806f5cef7d5bc11ad8ec8514ad6121efc73be6c7"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; Regenerate the shipped decision-core KIR. Combine with :test, which is
  ;; where the compiler lives:
  ;;
  ;;   clojure -M:test:gen
  :gen {:main-opts ["-m" "kotoba.mesh.kotoba-oracle-gen"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
